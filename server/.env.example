# --- Required ---
# PostgreSQL connection (Supabase pooler or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Signing key for JWT access tokens (use a long random string; min 32 chars in production)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# --- Server ---
PORT=4000
NODE_ENV=development

# JWT lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed browser origins (comma-separated). Used by CORS and Socket.IO.
# Include your Next.js dev URL and any production front-end URLs.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: Supabase (safe admin client; never expose service role in the browser) ---
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_ANON_KEY="your-anon-key"

# --- Optional ---
# LOG_LEVEL=info
